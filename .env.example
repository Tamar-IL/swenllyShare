# Copy to .env for local dev. Names and defaults only — never commit real secrets.
# See docs/design/architecture.md §9 for the authoritative list.

# --- Core ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
INBOUND_DOMAIN=share.swenlly.com

# --- Database ---
DATABASE_URL=postgres://postgres@127.0.0.1:54329/swenlly_dev
PGPOOL_MAX=10
# Set true to force TLS on the pg.Pool; in production, DATABASE_URL must carry
# sslmode=require|verify-ca|verify-full or this must be true, or boot fails fast.
PG_SSL=false

# --- Sessions / cookies ---
SESSION_SECRET=
COOKIE_SECURE=

# --- Adapter mode (fake|real; dev only per-port override e.g. "drive=fake,zoho=real") ---
ADAPTERS=fake
ADAPTER_OVERRIDES=

# --- Branded page ---
BRANDED_PAGE_ENABLED=false

# --- Upload / attachment limits (bytes) ---
ATTACH_LIMIT_BYTES=20971520
# 250MB — the corroborated Zoho WorkDrive simple-upload ceiling. Raise only after spike 1
# (docs/runbooks/live-spikes.md) confirms the >250MB chunked-upload shape, or set
# ZOHO_LARGE_UPLOAD_ENABLED=true once a founder has explicitly accepted that risk.
MAX_UPLOAD_BYTES=262144000

# --- Staging ---
STAGING_DIR=./staging
STAGING_RETENTION_HOURS=24

# --- SharingEngine ---
DRIVE_SHARE_SOFT_CAP=500
SHARE_PACE_MIN_INTERVAL_MS=1500

# --- Expiry ---
DEFAULT_EXPIRY_DAYS=30

# --- Rate limits (per hour) ---
RATE_REQUESTER_PER_HOUR=5
RATE_FILE_PER_HOUR=60
RATE_TENANT_PER_HOUR=300
RATE_MAGICLINK_PER_HOUR=5
# Per-requester-domain ceiling (F-8) — see src/config.ts.
RATE_DOMAIN_PER_HOUR=30

# --- Inbound retention ---
RAW_PAYLOAD_RETENTION_DAYS=7
# Pre-authentication quarantine writes, per resolved request-token, per hour (F-7).
QUARANTINE_PER_TOKEN_PER_HOUR=5

# --- Inbound email requests (Mailgun webhook) ---
# Kill switch: stays false until a live Mailgun payload confirms the DMARC/SPF/DKIM field
# guess below (docs/runbooks/live-spikes.md spike #3) — see src/adapters/mailgun/mapping.ts.
# NEVER flip this true in production without MAILGUN_AUTHSERV_ID also set (loadConfig
# refuses to boot production with it true and no MAILGUN_AUTHSERV_ID).
INBOUND_REQUESTS_ENABLED=false
# Which source(s) mapMailgunInboundPayload trusts for DMARC/SPF/DKIM:
# mailgun-fields (default) | authentication-results — exactly one source, chosen after spike 3.
INBOUND_AUTH_SOURCE=mailgun-fields
# REQUIRED before setting INBOUND_REQUESTS_ENABLED=true or ADAPTERS=real: the RFC 8601
# authserv-id our own Authentication-Results verdict is filed under. Must be a genuine,
# Mailgun-assigned value — NEVER INBOUND_DOMAIN (that is printed in every mailto link this
# product hands out, i.e. public and guessable) — see src/adapters/mailgun/mapping.ts and
# docs/reviews/critic-report.md F-B.
MAILGUN_AUTHSERV_ID=
# Caps the inbound webhook's raw body before Fastify/busboy parses any of it (F-10).
WEBHOOK_BODY_LIMIT_BYTES=2097152

# --- Google (service_account|oauth_refresh) ---
GOOGLE_CREDENTIAL_MODE=service_account
GOOGLE_SA_JSON_PATH=
GOOGLE_IMPERSONATE_SUBJECT=
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_ROOT_FOLDER_ID=
# oauth_refresh mode only (founder-fork: no Workspace central account)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Zoho ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_BASE=
ZOHO_TEAM_FOLDER_ID=
# OAuth token host — leave unset for the global DC (accounts.zoho.com); set for EU/IN/etc.
ZOHO_ACCOUNTS_BASE=
# WorkDrive create-link role id — default "6" (view); see src/adapters/zoho/real.ts
ZOHO_LINK_ROLE_ID=6
# Refuses (rather than silently attempts) the unverified >250MB chunked-upload path unless
# true — see src/adapters/zoho/real.ts uploadLargeFile's doc comment.
ZOHO_LARGE_UPLOAD_ENABLED=false

# --- Mailgun ---
MAILGUN_API_BASE=
MAILGUN_API_KEY=
MAILGUN_SIGNING_KEY=
MAILGUN_SENDING_DOMAIN=
OUTBOUND_FROM=

# --- Worker ---
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=8
