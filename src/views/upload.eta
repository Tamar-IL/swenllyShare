<%/* Upload screen (UX brief §1.3, visual-spec.md §4.5/§5). Data contract:
      it.csrfToken       string — sent by the island as the x-csrf-token XHR header
      it.maxUploadBytes  number — MAX_UPLOAD_BYTES, for client-side pre-flight only
                                  (the server enforces its own cap regardless)
      it.maxUploadLabel  string — human-readable ceiling for the size-limit copy (e.g.
                                  "1GB") — formatByteCeiling(maxUploadBytes)
*/%>
<div class="page page-upload">
  <a class="back-link" href="/files">
    <svg class="icon icon-mirror" aria-hidden="true"><use href="#icon-chevron-back" /></svg>
    חזרה לרשימה
  </a>
  <h1>העלאת קובץ</h1>

  <form
    id="upload-form"
    method="post"
    action="/api/files"
    enctype="multipart/form-data"
    data-upload-form
    data-csrf="<%= it.csrfToken %>"
    data-max-bytes="<%= it.maxUploadBytes %>"
  >
    <div class="dropzone" id="dropzone" data-state="idle">
      <div class="dropzone__view" data-view="idle">
        <svg class="icon dropzone__icon" aria-hidden="true"><use href="#icon-upload-cloud" /></svg>
        <p>גרור קובץ לכאן, או</p>
        <label class="btn btn-primary" for="file-input">בחר קובץ מהמחשב</label>
        <input class="visually-hidden-input" type="file" id="file-input" name="file" required />
        <p class="dropzone__limit">קבצים גדולים עד <span class="ltr-token"><%= it.maxUploadLabel %></span> נתמכים</p>
      </div>

      <div class="dropzone__view" data-view="uploading" hidden>
        <p class="dropzone__filename" id="upload-filename"></p>
        <progress class="progress-bar" id="upload-progress" value="0" max="100">0%</progress>
        <p class="dropzone__percent">
          <span id="upload-percent-text">0%</span>
          <span id="upload-eta-text"></span>
        </p>
        <button type="button" class="btn btn-secondary" id="upload-cancel">בטל</button>
      </div>

      <div class="dropzone__view" data-view="error" hidden>
        <svg class="icon dropzone__icon" aria-hidden="true"><use href="#icon-alert-circle" /></svg>
        <p class="dropzone__error-text" id="upload-error-text" role="alert"></p>
        <button type="button" class="btn btn-primary" id="upload-retry">נסה שוב</button>
      </div>
    </div>

  </form>
  <%/* No no-JS fallback here: `POST /api/files` (api-files.ts, outside this lane) reads
      the CSRF token only from the `x-csrf-token` XHR header, per architecture.md §8 — a
      plain form submit has no way to carry it, and progress/cancel (UX brief §1.3) need
      JS regardless. The upload screen is JS-required by design; every other screen in
      this app degrades to plain HTML forms without it. */%>

  <p id="upload-status-live" class="visually-hidden" role="status" aria-live="polite"></p>
</div>
