<%/* The one shell every page renders inside (architecture.md §11, visual-spec.md §1-2).
    `@fastify/view`'s Eta layout support re-renders this template with the SAME data
    object each route passed to `reply.view(page, data)`, plus `body` (the already-
    rendered content template) merged in — so every field below is one any HTML route in
    signin.ts/files.ts/public-share.ts can simply include in its own `reply.view(...)`
    call; nothing extra is wired up on the fastify/container side.

    Data contract:
      it.title      string             — <title>, defaults to "Swenlly Share" (app.ts)
      it.body       string (raw HTML)  — the content template's rendered output
      it.appHeader  boolean|undefined  — true: full header (wordmark links to /files +
                                          a sign-out button, needs it.csrfToken). Falsy
                                          (the default): a minimal centered wordmark with
                                          no navigation — used pre-auth (sign-in) and on
                                          public/error pages (visual-spec.md §5: sign-in
                                          and the branded page both get "no nav" chrome).
      it.csrfToken  string|undefined   — required when it.appHeader is true
      it.flash      string|undefined   — one-shot informational banner (role="status"),
                                          e.g. "ההגדרות נשמרו." after a settings save
      it.hideFooter boolean|undefined  — true on the recipient-facing branded page
                                          (visual-spec.md §5: "no branding chrome beyond
                                          the wordmark — no nav, no upsell"); the sender
                                          app's own footer counts as exactly that chrome
                                          from a recipient's point of view
*/%>
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= it.title %> · Swenlly Share</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;500;600;700&display=swap"
    />
    <link rel="stylesheet" href="/assets/app.css" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">דלג לתוכן הראשי</a>

    <!-- Inline icon sprite (visual-spec.md §3): one <symbol> per icon, referenced via
         <svg class="icon"><use href="#icon-NAME"/></svg>. Same-document <use>, so this
         needs no extra network request and nothing for the CSP's img-src/script-src to
         even consider. -->
    <svg hidden aria-hidden="true" focusable="false">
      <symbol id="icon-file" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2h8l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" />
        <path d="M14 2v5h5" />
      </symbol>
      <symbol id="icon-file-video" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2h8l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" />
        <path d="M14 2v5h5" />
        <path d="M10.5 12.5l4 2.25-4 2.25v-4.5z" />
      </symbol>
      <symbol id="icon-upload-cloud" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 18a4.5 4.5 0 0 1-.5-8.97A5.5 5.5 0 0 1 17.3 8.03 4 4 0 0 1 17 16" />
        <path d="M12 12v7" />
        <path d="M9 15l3-3 3 3" />
      </symbol>
      <symbol id="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="12" height="12" rx="2" />
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
      </symbol>
      <symbol id="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12" />
      </symbol>
      <symbol id="icon-download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3v12" />
        <path d="M7 10l5 5 5-5" />
        <path d="M4 19h16" />
      </symbol>
      <symbol id="icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 7h16" />
        <path d="M9 7V4h6v3" />
        <path d="M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13" />
        <path d="M10 11v6" />
        <path d="M14 11v6" />
      </symbol>
      <symbol id="icon-chevron-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6" />
      </symbol>
      <symbol id="icon-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3.5 2" />
      </symbol>
      <symbol id="icon-alert-circle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7.5v6" />
        <path d="M12 16.5h.01" />
      </symbol>
      <symbol id="icon-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
        <path d="M3 6.5l9 6 9-6" />
      </symbol>
      <symbol id="icon-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 14a4.5 4.5 0 0 0 6.4.3l2.1-2.1a4.5 4.5 0 0 0-6.36-6.37L10.9 7.05" />
        <path d="M14 10a4.5 4.5 0 0 0-6.4-.3L5.5 11.8a4.5 4.5 0 0 0 6.36 6.37l1.24-1.22" />
      </symbol>
    </svg>

    <header class="site-header<%= it.appHeader ? '' : ' site-header--minimal' %>">
      <div class="site-header__inner">
        <% if (it.appHeader) { %>
        <a class="wordmark" href="/files">Swenlly Share</a>
        <form method="post" action="/signout" class="signout-form">
          <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />
          <button type="submit" class="btn btn-secondary btn-sm">התנתקות</button>
        </form>
        <% } else { %>
        <span class="wordmark">Swenlly Share</span>
        <% } %>
      </div>
    </header>

    <% if (it.flash) { %>
    <div class="flash-banner" role="status"><%= it.flash %></div>
    <% } %>

    <main id="main-content" class="site-main">
      <%~ it.body %>
    </main>

    <% if (!it.hideFooter) { %>
    <footer class="site-footer">
      <p>Swenlly Share — שיתוף קבצים שעובר את הסינון.</p>
    </footer>
    <% } %>

    <!-- Shared announcer for the island's copy-confirmation / status toasts
         (visual-spec.md §4.3, §4.5) — a single aria-live region so announcements aren't
         tied to any one control's own DOM position. -->
    <div id="live-region" class="visually-hidden" role="status" aria-live="polite"></div>

    <script src="/assets/island.js" defer></script>
  </body>
</html>
