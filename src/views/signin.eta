<%/* Sign-in (UX brief §1.1, visual-spec.md §5). Data contract:
      it.sent       boolean  — true after a successful POST /signin (show the "check your
                                mail" state instead of the form; no disclosure either way
                                of whether the email is registered)
      it.email      string?  — value to prefill if redisplaying the form after an error
      it.error      string?  — a generic error message (e.g. the magic link was invalid)
      it.csrfToken  string   — for the hidden _csrf field
*/%>
<div class="page page-signin">
  <div class="signin-card">
    <h1 class="signin-card__wordmark">Swenlly Share</h1>
    <% if (it.sent) { %>
    <p role="status" class="signin-card__message">
      אם הכתובת קיימת במערכת, נשלח אליה קישור כניסה. בדוק/י את תיבת הדואר.
    </p>
    <% } else { %>
    <% if (it.error) { %>
    <p role="alert" class="form-alert"><%= it.error %></p>
    <% } %>
    <form method="post" action="/signin" class="stacked-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />
      <div class="field">
        <label for="email">כתובת אימייל</label>
        <input
          id="email"
          class="input"
          type="email"
          name="email"
          dir="ltr"
          autocomplete="email"
          required
          value="<%= it.email || '' %>"
        />
      </div>
      <button type="submit" class="btn btn-primary btn-block">שלח קישור כניסה</button>
      <p class="signin-card__help">אין צורך בסיסמה — נשלח לך קישור התחברות למייל.</p>
    </form>
    <% } %>
  </div>
</div>
